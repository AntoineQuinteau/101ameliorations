{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "101ameliorations",
  "main": "workers/app/src/index.ts",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /k/:id (Open Graph tags), /r/:slug (campaign redirect) and the iOS
    // manifest need the Worker, see workers/app/src/index.ts; every other route keeps going
    // straight to the asset pipeline exactly as before.
    "run_worker_first": ["/k/*", "/r/*", "/ios-manifest.webmanifest"],
  },
}
