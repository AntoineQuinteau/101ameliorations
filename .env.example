# Supabase API URL (local: http://127.0.0.1:54321 — prod: https://<ref>.supabase.co)
VITE_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
# MapTiler API key. Required unless VITE_TILE_BASE_URL below points away from
# MapTiler (see src/env.ts) — e.g. with the dev tile proxy, leave this unset
# and set MAPTILER_KEY (no VITE_ prefix) instead, or leave both unset to run
# without ever calling MapTiler at all.
VITE_MAPTILER_KEY=
# Cloudflare Turnstile site key (optional — the app runs fine without it,
# see src/env.ts and src/features/auth/useTurnstile.ts). Locally / in CI, use
# Cloudflare's dummy always-passing invisible key: 1x00000000000000000000BB.
VITE_TURNSTILE_SITE_KEY=
# Sentry DSN (optional — the app runs fine without it, see src/lib/sentry.ts)
VITE_SENTRY_DSN=
# Optional Sentry environment tag (CI sets `staging` / `production`). Falls
# back to Vite's mode — leave empty locally.
VITE_SENTRY_ENVIRONMENT=
# Optional. Points the map at the dev tile proxy (vite-plugins/tileProxy.ts,
# served at /__tiles) instead of MapTiler directly, so local dev and e2e runs
# don't spend MapTiler quota. Recommended for local dev: /__tiles
VITE_TILE_BASE_URL=
# Upstream MapTiler key for the dev tile proxy above — no VITE_ prefix, so
# it's read server-side only and never lands in the client bundle. Only
# needed if you want the proxy to fetch real tiles instead of a placeholder.
MAPTILER_KEY=
