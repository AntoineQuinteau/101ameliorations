# Supabase API URL (local: http://127.0.0.1:54321 — prod: https://<ref>.supabase.co)
VITE_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
# MapTiler API key
VITE_MAPTILER_KEY=
# Cloudflare Turnstile site key (optional — the app runs fine without it,
# see src/env.ts and src/features/auth/useTurnstile.ts). Locally / in CI, use
# Cloudflare's dummy always-passing invisible key: 1x00000000000000000000BB.
VITE_TURNSTILE_SITE_KEY=
# Sentry DSN (optional — the app runs fine without it, see src/lib/sentry.ts)
VITE_SENTRY_DSN=
