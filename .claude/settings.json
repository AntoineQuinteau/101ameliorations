{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run build)",
      "Bash(npm run db:test)",
      "Bash(npm run e2e)",
      "Bash(npm run e2e *)",
      "Bash(npm run gen:types)",
      "Bash(npm run gen:icons)",
      "Bash(npm run gen:og-image)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx playwright test *)",
      "Bash(npx supabase start)",
      "Bash(npx supabase stop)",
      "Bash(npx supabase status)",
      "Bash(npx supabase db reset)",
      "Bash(npx supabase db reset --no-seed)",
      "Bash(npx supabase test db)",
      "Bash(npx supabase migration new *)",
      "Bash(npx supabase migration list --local)",
      "Bash(npx supabase db diff *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(docker ps)",
      "Bash(docker ps *)",
      "Bash(docker info)",
      "Bash(docker logs *)"
    ],
    "ask": [
      "Bash(npx supabase * --linked*)",
      "Bash(npx supabase * --db-url *)",
      "Bash(npx supabase db push *)",
      "Bash(npx supabase link *)",
      "Bash(npx wrangler deploy *)",
      "Bash(npx wrangler versions *)",
      "Bash(npx wrangler secret *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/wait-for-setup.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
